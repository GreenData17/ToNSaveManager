<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>ToNSaveManager</RootNamespace>
        <AssemblyName>ToNSaveManager.Core</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DefineConstants>$(DefineConstants)$(FeatureFlags.Replace("#",";"))</DefineConstants>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="ToNSaveManager" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
        <PackageReference Include="Jint" Version="4.2.2" />
        <PackageReference Include="NAudio.Core" Version="2.2.1" />
        <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
        <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
        <PackageReference Include="VRChat.OSCQuery" Version="0.0.7" />
        <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
        <PackageReference Include="VRCOscLib" Version="1.6.0" />
        <PackageReference Include="WatsonWebsocket" Version="4.1.2" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\Localization\Language\*.json"
                          LinkBase="Localization\Language"
                          LogicalName="ToNSaveManager.Localization.Language.%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\Resources\index.json;..\Resources\objectives.json;..\Resources\xs_icon.png;..\Resources\notification.wav;..\Resources\notification_copy.wav;..\Resources\notification_secret.wav"
                          LinkBase="Resources"
                          LogicalName="ToNSaveManager.Resources.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
